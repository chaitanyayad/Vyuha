# VYUHA runs with no .env at all. Everything below is optional.

# --- gateway ---------------------------------------------------------
VYUHA_HOST=127.0.0.1
VYUHA_PORT=8000
# Boot value for the T21 toggle. Flip it at runtime from the dashboard.
VYUHA_ENFORCE=true
VYUHA_DB_URL=sqlite:///vyuha.db
VYUHA_POLICY=policies/default.yaml

# --- Ring 4, the semantic judge --------------------------------------
# auto = use the model if a key is present, otherwise the local heuristic.
# The heuristic backend needs no network and no key.
VYUHA_JUDGE_BACKEND=auto
VYUHA_JUDGE_MODEL=claude-haiku-4-5-20251001
VYUHA_JUDGE_TIMEOUT=2.0

# --- agent planner ---------------------------------------------------
# scripted = deterministic and offline (what the scenario suites run on)
# llm      = drive a real model over the same six tools
VYUHA_PLANNER=scripted
VYUHA_PLANNER_MODEL=claude-sonnet-5

# Only needed for VYUHA_PLANNER=llm or VYUHA_JUDGE_BACKEND=llm.
ANTHROPIC_API_KEY=
